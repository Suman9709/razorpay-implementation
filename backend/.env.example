# Test credentials only. Never commit the real backend/.env file.
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
# Create a different, high-entropy secret when configuring the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=replace_with_a_different_webhook_secret
